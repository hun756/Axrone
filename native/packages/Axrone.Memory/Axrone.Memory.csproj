<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Memory</RootNamespace>
    <AssemblyName>Axrone.Memory</AssemblyName>
    <Description>Memory pools, object pools, and allocator primitives for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1724: Type name conflicts with namespace — intentional module naming -->
    <NoWarn>$(NoWarn);CA1724</NoWarn>
    <!-- CA1000: Static members on generic types — intentional for Singleton&lt;T&gt;/SingletonAuto&lt;T&gt; API -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1031: Catching general exceptions — intentional for shutdown teardown -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
    <!-- CA1002: Don't use List&lt;T&gt; — too strict for engine utility library -->
    <NoWarn>$(NoWarn);CA1002</NoWarn>
    <!-- CA1024: Use properties — GetInstance() methods are intentional API design -->
    <NoWarn>$(NoWarn);CA1024</NoWarn>
    <!-- CA1034: Nested types — RAII scope structs are intentional design -->
    <NoWarn>$(NoWarn);CA1034</NoWarn>
    <!-- CA1508: Dead code — false positive on lock-protected static fields -->
    <NoWarn>$(NoWarn);CA1508</NoWarn>
    <!-- CA1815: Struct Equals/GetHashCode — lightweight tracker structs -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA2201: OutOfMemoryException reserved by runtime — pool throws it for quota exhaustion -->
    <NoWarn>$(NoWarn);CA2201</NoWarn>
    <!-- CA1711: Type name ends in 'Flags' — intentional for flags enumeration naming -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <!-- CA2000: Dispose objects before losing scope — false positive on buffer dequeue for size tracking -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
    <!-- CA2227: Collection property should be read-only — intentional mutable list for builder pattern -->
    <NoWarn>$(NoWarn);CA2227</NoWarn>
    <!-- CA1720: Identifier contains type name — 'Pointer' is standard naming for native pointer access -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- CA1028: Enum storage type — byte/uint chosen for memory layout compatibility -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1716: Get method name — intentional API design for registry pattern -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <!-- CA1065: Property throws — intentional for singleton access before configuration -->
    <NoWarn>$(NoWarn);CA1065</NoWarn>
    <!-- CA1849: .Result usage — intentional for sync-over-async in disposal paths -->
    <NoWarn>$(NoWarn);CA1849</NoWarn>
    <!-- IL2091: AOT trim annotations — Lazy&lt;T&gt; generic constraints are satisfied at runtime -->
    <NoWarn>$(NoWarn);IL2091</NoWarn>
    <!-- CA1512: Use ThrowIfNegativeOrZero — explicit throw is intentional for custom messages -->
    <NoWarn>$(NoWarn);CA1512</NoWarn>
    <!-- CA2208: paramName casing — options property names are intentional for record init -->
    <NoWarn>$(NoWarn);CA2208</NoWarn>
    <!-- CA1051: Do not declare visible instance fields — struct fields are intentional for perf -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1062: Validate arguments of public methods — pool internals trust callers -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
    <!-- CA1033: Interface methods should be callable by child types — pool design choice -->
    <NoWarn>$(NoWarn);CA1033</NoWarn>
    <!-- CA1816: GC.SuppressFinalize — pool types don't need finalizers -->
    <NoWarn>$(NoWarn);CA1816</NoWarn>
    <!-- CA1822: Mark members as static — instance members are intentional for pool design -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <!-- CA1825: Avoid zero-length array allocations — Array.Empty not always appropriate -->
    <NoWarn>$(NoWarn);CA1825</NoWarn>
    <!-- CA1850: Prefer static HashAlgorithm instance — pool creates per-instance for thread safety -->
    <NoWarn>$(NoWarn);CA1850</NoWarn>
    <!-- CA1854: Prefer 'TryGetValue' — pool internal patterns use different access patterns -->
    <NoWarn>$(NoWarn);CA1854</NoWarn>
    <!-- CA5394: Do not use insecure randomness — pool doesn't use randomness -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
    <!-- CA1027: Mark enums with FlagsAttribute — pool enums are not flags -->
    <NoWarn>$(NoWarn);CA1027</NoWarn>
    <!-- CA1008: Enum needs None=0 — pool enums intentionally start at non-zero values -->
    <NoWarn>$(NoWarn);CA1008</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Memory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Collections/Axrone.Collections.csproj" />
    <ProjectReference Include="../Axrone.Utility/Axrone.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
