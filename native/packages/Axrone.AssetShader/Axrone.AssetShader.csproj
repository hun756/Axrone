<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.AssetShader</RootNamespace>
    <AssemblyName>Axrone.AssetShader</AssemblyName>
    <Description>Shader effect engine with typestate builders, GLSL preprocessing, variant baking and importers for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA2225: Implicit operators need named alternatives — nominal
         conversion surface is complete without them. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1034: Nested types — duck-typed struct enumerators are an
         intentional zero-allocation traversal design. -->
    <NoWarn>$(NoWarn);CA1034</NoWarn>
    <!-- CA1032: Standard exception ctors — shader errors carry coded
         (code, message) payloads instead of free-form messages. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1028: byte-backed shader enums — wire-sized discriminants,
         intentional. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1815: Equals on stateless structs — policy structs carry
         no state to compare. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1000: Static members on generic types — policy monomorphization
         exposes static abstracts on generic structs by design. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1031: Catching general exceptions — importer probing returns
         failure results instead of throwing; never silently swallowed. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
    <!-- CA1040: Empty marker interfaces drive the typestate builder phases. -->
    <NoWarn>$(NoWarn);CA1040</NoWarn>
    <!-- CA1308: Lowercase tokens are the GLSL wire format; Invariant culture
         keeps the mapping deterministic. -->
    <NoWarn>$(NoWarn);CA1308</NoWarn>
    <!-- CA1720: Enum members mirror GLSL type keywords (float, int, uint);
         renaming would corrupt the shader domain language. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- CA2227/CA1002: JSON DTOs require mutable List<T> setters for
         source-generated deserialization; they are not public API collections. -->
    <NoWarn>$(NoWarn);CA2227</NoWarn>
    <NoWarn>$(NoWarn);CA1002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.AssetShader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Asset/Axrone.Asset.csproj" />
    <ProjectReference Include="../Axrone.Hash/Axrone.Hash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
