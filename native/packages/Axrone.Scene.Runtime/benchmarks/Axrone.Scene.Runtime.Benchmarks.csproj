<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Axrone.Scene.Runtime.Benchmarks</RootNamespace>
    <AssemblyName>Axrone.Scene.Runtime.Benchmarks</AssemblyName>
    <Description>Microbenchmarks for scene frame planning and authoring paths.</Description>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet emits IL that reflects over these types; trimming would break the harness. -->
    <IsTrimmable>false</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1052: static holder types — benchmark fixtures are conventionally plain classes. -->
    <NoWarn>$(NoWarn);CA1052</NoWarn>
    <!-- CA1515: make types internal — BenchmarkSwitcher discovers fixtures through public types. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1001: disposable fields — benchmark fixtures release them in [GlobalCleanup]. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Scene.Runtime.csproj" />
  </ItemGroup>

</Project>
