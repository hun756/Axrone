<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Scene.Rendering</RootNamespace>
    <AssemblyName>Axrone.Scene.Rendering</AssemblyName>
    <Description>Backend-agnostic scene rendering for the Axrone engine: camera frames, lighting collection, render-item planning, culling and sorting.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA2225: Operator overloads need named alternatives — comparers and
         descriptors expose explicit constructors/factories. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1051: Visible instance fields — render payloads are explicit
         cache-friendly layouts. -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1815: Equals on transient structs — render items are consumed by
         sorters and never compared as values. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1000: Static members on generic types — sort comparers are closed
         over the item type by design. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1032: Standard exception ctors — scene rendering errors carry stable
         codes and optional payloads. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1028: byte-backed enums — component payloads use wire-sized
         discriminants to keep actor columns compact. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Scene.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Scene.Core/Axrone.Scene.Core.csproj" />
    <ProjectReference Include="../Axrone.Scene.Assets/Axrone.Scene.Assets.csproj" />
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
    <ProjectReference Include="../Axrone.Lighting/Axrone.Lighting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
