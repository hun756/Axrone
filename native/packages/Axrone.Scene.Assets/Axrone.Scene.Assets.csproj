<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Scene.Assets</RootNamespace>
    <AssemblyName>Axrone.Scene.Assets</AssemblyName>
    <Description>Backend-agnostic scene asset definitions and registries for the Axrone engine: shaders, meshes, materials, textures, samplers and render passes.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA2225: Operator overloads need named alternatives — asset ids expose
         FromName and their value constructor alongside comparison operators. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1051: Visible instance fields — vertex attribute payloads are
         explicit wire layouts. -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1028: Byte-backed enums — mesh topology and semantics are wire-sized. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1815: Equals on transient structs — attribute views are consumed
         positionally. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1000: Static members on generic types — asset id factories belong to
         the closed generic that owns the tag. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Scene.Assets.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Scene.Core/Axrone.Scene.Core.csproj" />
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
