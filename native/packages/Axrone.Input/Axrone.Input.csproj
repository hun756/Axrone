<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Input</RootNamespace>
    <AssemblyName>Axrone.Input</AssemblyName>
    <Description>Input transport and action system for the Axrone engine: lock-free event queue, frame snapshots and Silk-compatible device codes.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1028: byte/short-backed input enums — wire-sized codes matching Silk.NET, intentional. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1008: Key carries Silk.NET codes with no zero member; Unknown (-1) is the sentinel. -->
    <NoWarn>$(NoWarn);CA1008</NoWarn>
    <!-- CA2225: Implicit operators need named alternatives — the nominal
         From/round-trip members already cover expression forms. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1000: Static members on generic types — the typestate builder
         exposes policy selection statically by design. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1815: Equals on stateless structs — policy and sink structs carry
         no state to compare; elementwise Equals would be unused surface. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1711: Type name ends in 'Queue' — queue is the documented
         transport vocabulary for the event channel. -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Input.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Utility/Axrone.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
