<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Patterns</RootNamespace>
    <AssemblyName>Axrone.Patterns</AssemblyName>
    <Description>Zero-allocation visitor and traversal infrastructure for the Axrone engine: node identities, typestate arenas, static-dispatch policies and iterative traversals.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1815: Override Equals on value types — the inline buffers are traversal
         scratch storage compared by identity of contents never; elementwise equality
         over 128/256 lanes would be surface nobody should call. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1036: Comparison operators on comparable types — Unit is zero-sized and
         all instances compare equal; relational operators would be noise. -->
    <NoWarn>$(NoWarn);CA1036</NoWarn>
    <!-- CA1040: Empty marker interface — IArenaPhase is the compile-time phase token
         that separates writable and sealed arenas; it carries no members by design. -->
    <NoWarn>$(NoWarn);CA1040</NoWarn>
    <!-- CA1716: Get collides with a reserved word — Get(handle) is the slot-lookup
         verb across the whole arena surface; renaming it would break the uniform
         naming the traversal code relies on. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <!-- CA2201: IndexOutOfRangeException is reserved — a bad handle names no live
         slot, and IndexOutOfRangeException is exactly what callers catch for it. -->
    <NoWarn>$(NoWarn);CA2201</NoWarn>
    <!-- CA1000: Static members on generic types — static dispatch over generic
         policies and traversals IS the design (no instances, no virtual calls);
         every static here closes over its type arguments. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Patterns.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
