<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Raycast</RootNamespace>
    <AssemblyName>Axrone.Raycast</AssemblyName>
    <Description>Broadphase raycast engine for the Axrone engine: BVH traversal, shape casts and continuous queries over the geometric primitives owned by Axrone.Geometry.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1040: Empty marker interface — IBuilderPhase is the compile-time stage
         token separating unconfigured and configured build states by design. -->
    <NoWarn>$(NoWarn);CA1040</NoWarn>
    <!-- CA1000: Static members on generic types — BvhPipelineBuilder.Create is the
         typestate entry point; the stage parameter only exists on the generic
         builder, so the factory cannot live elsewhere without losing the stage. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1028: RaycastFlags and RaycastLayer are 32-bit masks applied to the physics
         layer word; RaycastShapeKind is a byte so a shape descriptor stays compact. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1711: RaycastFlags is the documented physics-contract name for the option
         set and is consumed by scene/physics callers by that name. -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <!-- CA2217: RaycastLayer.All deliberately spans every bit, including bits that no
         named member owns, so it is not a combination of the declared members. -->
    <NoWarn>$(NoWarn);CA2217</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Raycast.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
