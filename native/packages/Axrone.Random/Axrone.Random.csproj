<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Random</RootNamespace>
    <AssemblyName>Axrone.Random</AssemblyName>
    <Description>High-performance pseudo-random number generation for the Axrone engine: engine cores, a generic RandomEngine wrapper, a thread-local static facade and a striped concurrent facade.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1724: Type name conflicts with namespace - 'Random' intentionally shadows System.Random inside Axrone.Random -->
    <NoWarn>$(NoWarn);CA1724</NoWarn>
    <!-- CA1000: Static members on generic types - the static facade is deliberately specialised per engine -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1815: Struct Equals/GetHashCode - RandomEngine is a mutable state holder, equality is not meaningful -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1063: Dispose pattern - ConcurrentRandom uses Interlocked state transitions for teardown -->
    <NoWarn>$(NoWarn);CA1063</NoWarn>
    <!-- CA1816: GC.SuppressFinalize - ConcurrentRandom has no finalizer -->
    <NoWarn>$(NoWarn);CA1816</NoWarn>
    <!-- CA2213: Disposable fields - the striped engine state owns no unmanaged resources -->
    <NoWarn>$(NoWarn);CA2213</NoWarn>
    <!-- CA1508: Dead code - false positive for volatile lifecycle fields checked under a striped gate -->
    <NoWarn>$(NoWarn);CA1508</NoWarn>
    <!-- CA1031: General exception catch - teardown must not leak lifecycle faults to the caller -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
    <!-- CA1002: Do not use List&lt;T&gt; - no collection is exposed on the public surface -->
    <NoWarn>$(NoWarn);CA1002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Random.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Utility/Axrone.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
