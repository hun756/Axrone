<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Axrone.Random.Benchmarks</RootNamespace>
    <AssemblyName>Axrone.Random.Benchmarks</AssemblyName>
    <Description>Head-to-head microbenchmarks of Axrone.Random against System.Random.</Description>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet emits IL that reflects over these types; trimming would break the harness. -->
    <IsTrimmable>false</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1052: static holder types — benchmark fixtures are conventionally plain static classes -->
    <NoWarn>$(NoWarn);CA1052</NoWarn>
    <!-- CA5394: insecure randomness — benchmark inputs use a fixed seed for reproducibility -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
    <!-- CA1515: make types internal — BenchmarkSwitcher discovers fixtures through public types -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1707: underscores in benchmark names — BenchmarkDotNet display convention -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- CA1303/CA1305: the manual AOT harness writes a plain console table; localization is not a goal -->
    <NoWarn>$(NoWarn);CA1303;CA1305</NoWarn>
    <!-- CA1001/CA1063: disposable fields without the full pattern — BenchmarkSwitcher requires
         non-sealed fixtures; teardown runs deterministically in GlobalCleanup -->
    <NoWarn>$(NoWarn);CA1001;CA1063</NoWarn>
  </PropertyGroup>

  <!-- AOT is selected on the command line (dotnet publish -p:PublishAot=true), never here. When it
       is set, BenchmarkDotNet is dropped (it is not trim/AOT clean) and the no-op attribute shims
       are compiled so the benchmark class and the manual harness still build. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BenchmarkDotNetShims.cs" />
    <Compile Remove="BenchmarkDotNetConfigShims.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Compile Include="BenchmarkDotNetShims.cs" />
    <Compile Include="BenchmarkDotNetConfigShims.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Random.csproj" />
  </ItemGroup>

</Project>
