<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Scene.Snapshot</RootNamespace>
    <AssemblyName>Axrone.Scene.Snapshot</AssemblyName>
    <Description>Self-contained scene snapshots for the Axrone engine: asset payloads, prefab composition, deterministic JSON and transactional loading.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1032: Standard exception ctors — snapshot errors carry stable codes. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1815: Equals on transient structs — snapshot records are wire-shaped
         data carriers consumed positionally. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1031: Transactional loading must catch any failure to roll back the
         partial asset registrations before reporting a coded snapshot error. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Scene.Snapshot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Scene.Core/Axrone.Scene.Core.csproj" />
    <ProjectReference Include="../Axrone.Scene.Assets/Axrone.Scene.Assets.csproj" />
    <ProjectReference Include="../Axrone.Scene.Prefab/Axrone.Scene.Prefab.csproj" />
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
