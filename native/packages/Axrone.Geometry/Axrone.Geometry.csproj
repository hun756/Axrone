<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Geometry</RootNamespace>
    <AssemblyName>Axrone.Geometry</AssemblyName>
    <Description>Geometry value types (aabb, ray, sphere, frustum, spatial tree) for the Axrone engine: layout-stable, interop-friendly and allocation-free. Shapes are expressed in the scalar primitives owned by Axrone.Numeric; this package adds bounds/visibility/acceleration-structure queries only.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA2225: Operator overloads need named alternatives — the identity/capacity/
         distance surface is a set of value types whose casts are the documented API.
         The Value property and the public constructors already cover the shapes that
         need an expression form, so twin factory methods would only double the surface. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1028: byte-backed status enums — wire-sized discriminants, intentional. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Geometry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>