<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Profiler</RootNamespace>
    <AssemblyName>Axrone.Profiler</AssemblyName>
    <Description>Sampling profiler with clocks, flame graphs, memory tracking and machine telemetry for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1724: ProfilerStopwatch avoids clashing with System.Diagnostics.Stopwatch. -->
    <NoWarn>$(NoWarn);CA1724</NoWarn>
    <!-- CA1024: Web-mapped getters stay methods (ToUnixMs, GetRoots,
         GetStatistics, GetState); matches the profiler reference API. -->
    <NoWarn>$(NoWarn);CA1024</NoWarn>
    <!-- IL2026: StackTrace reflection is diagnostics-only; trimmed apps
         get fewer frames, never a crash (nulls are skipped). -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
    <!-- CA2225: Operator overloads need named alternatives — nominal
         arithmetic surfaces Next/Add/Subtract where it matters. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1032: Standard exception ctors — profiler errors carry coded
         (code, message) payloads instead of free-form messages. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1028: byte-backed profiler enums — wire-sized discriminants, intentional. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1000: Static members on generic types — policy monomorphization
         exposes static abstracts on generic structs by design. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1031: Catching general exceptions — intentional for per-tick
         failure capture; failures are reported, never swallowed. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Profiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Utility/Axrone.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
