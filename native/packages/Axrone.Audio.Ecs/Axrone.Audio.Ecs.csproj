<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Audio.Ecs</RootNamespace>
    <AssemblyName>Axrone.Audio.Ecs</AssemblyName>
    <Description>ECS binding for the Axrone audio system: unmanaged audio components plus the command binder.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Audio.Ecs.Tests" />
  </ItemGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1051: Visible instance fields — ECS components are mutable
         column data by design, matching transform component precedent. -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1815: Equals on link structs — single-id payloads compare by
         record-structural default only where used; custom Equals is dead surface. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Audio/Axrone.Audio.csproj" />
    <ProjectReference Include="../Axrone.Ecs/Axrone.Ecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
