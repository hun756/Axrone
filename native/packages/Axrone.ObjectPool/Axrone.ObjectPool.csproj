<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.ObjectPool</RootNamespace>
    <AssemblyName>Axrone.ObjectPool</AssemblyName>
    <Description>High-performance object pool with diagnostics, scavenging, and multiple concurrency strategies for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <NoWarn>$(NoWarn);CA1724;CA1000;CA1031;CA1002;CA1024;CA1034;CA1508;CA1815;CA2201;CA1711;CA2000;CA2227;CA1720;CA1028;CA1051;CA1062;CA1033;CA1816;CA1822;CA1825;CA1850;CA1854;CA2208;CA5394;CA1008;CA1027;CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.ObjectPool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
