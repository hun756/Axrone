<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Axrone.Batching.Benchmarks</RootNamespace>
    <AssemblyName>Axrone.Batching.Benchmarks</AssemblyName>
    <Description>Microbenchmarks for Axrone.Batching kernels.</Description>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet emits IL that reflects over these types; trimming would break the harness. -->
    <IsTrimmable>false</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1052: static holder types — benchmark fixtures are conventionally plain static classes -->
    <NoWarn>$(NoWarn);CA1052</NoWarn>
    <!-- CA5394: insecure randomness — benchmark inputs use a fixed seed for reproducibility -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
    <!-- CA1515: make types internal — BenchmarkSwitcher discovers fixtures through public types -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Batching.csproj" />
  </ItemGroup>

</Project>
