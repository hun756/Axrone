<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Terrain.Chunks</RootNamespace>
    <AssemblyName>Axrone.Terrain.Chunks</AssemblyName>
    <Description>Chunked terrain residency, sculpting, foliage scatter, mesh building and grid raycasting for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1032: Standard exception ctors — chunk errors carry the terrain code surface. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1051: Visible instance fields — the 64-byte slot header is an explicit
         cache-line layout shared with native memory. -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1815: Equals on value types — header and cell records are never compared. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1305: Invariant formatting is used at every message site. -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
    <!-- CA1062: Public validation is centralized in options/brush Validate. -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
    <!-- CA1819: Buffer access exposes spans and arrays for upload without copying. -->
    <NoWarn>$(NoWarn);CA1819</NoWarn>
    <!-- CA2225: No operators need named alternatives. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Terrain.Chunks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
    <ProjectReference Include="../Axrone.Memory/Axrone.Memory.csproj" />
    <ProjectReference Include="../Axrone.Terrain/Axrone.Terrain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
