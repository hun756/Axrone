{
    "name": "@axrone/terrain",
    "version": "0.1.0",
    "description": "Heightmap-driven terrain authoring primitives: heightmap data model, procedural generation, mesh building, physics heightfield sources.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.mjs",
            "require": "./dist/types.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.mjs",
            "require": "./dist/errors.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rollup -c rollup.config.mjs",
        "clean": "rimraf dist",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "lint": "eslint src --ext .ts"
    },
    "keywords": [
        "terrain",
        "heightmap",
        "heightfield",
        "procedural",
        "noise",
        "mesh",
        "game-engine"
    ],
    "author": "Axrone",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@axrone/numeric": "^0.0.1",
        "@axrone/random": "^0.0.1",
        "@axrone/utility": "^0.0.1"
    }
}
