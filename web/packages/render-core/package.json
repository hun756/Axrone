{
    "name": "@axrone/render-core",
    "version": "0.1.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.mjs",
            "require": "./dist/types.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.mjs",
            "require": "./dist/errors.js"
        },
        "./memory": {
            "types": "./dist/memory.d.ts",
            "import": "./dist/memory.mjs",
            "require": "./dist/memory.js"
        },
        "./graph": {
            "types": "./dist/graph.d.ts",
            "import": "./dist/graph.mjs",
            "require": "./dist/graph.js"
        },
        "./post-process": {
            "types": "./dist/post-process.d.ts",
            "import": "./dist/post-process.mjs",
            "require": "./dist/post-process.js"
        },
        "./pipeline": {
            "types": "./dist/pipeline.d.ts",
            "import": "./dist/pipeline.mjs",
            "require": "./dist/pipeline.js"
        },
        "./planner": {
            "types": "./dist/planner.d.ts",
            "import": "./dist/planner.mjs",
            "require": "./dist/planner.js"
        },
        "./shader-effect": {
            "types": "./dist/shader-effect.d.ts",
            "import": "./dist/shader-effect.mjs",
            "require": "./dist/shader-effect.js"
        }
    },
    "scripts": {
        "build": "rollup -c rollup.config.mjs",
        "clean": "rimraf dist",
        "test": "vitest run"
    },
    "dependencies": {
        "@axrone/geometry": "^0.1.0",
        "@axrone/numeric": "^0.0.1"
    }
}