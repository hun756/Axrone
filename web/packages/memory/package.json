{
    "name": "@axrone/memory",
    "version": "0.0.1",
    "description": "High-performance memory management primitives: pools, buffers, heaps, queues, stacks, lazy evaluation.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rollup -c rollup.config.mjs",
        "clean": "rimraf dist",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "lint": "eslint src --ext .ts"
    },
    "keywords": [
        "memory",
        "pool",
        "object-pool",
        "buffer",
        "typed-array",
        "heap",
        "priority-queue",
        "stack",
        "lazy",
        "lru",
        "data-structures"
    ],
    "author": "Axrone",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
